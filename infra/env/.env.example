# =====================================================
# TapAi - Development Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# =====================================================

# ── PostgreSQL - Command DB (Write) ───────────────────
COMMAND_DB_HOST=localhost
COMMAND_DB_PORT=5433
COMMAND_DB_NAME=tapai_command
COMMAND_DB_USER=tapai
COMMAND_DB_PASSWORD=tapai_password

# ── PostgreSQL - Query DB (Read) ──────────────────────
QUERY_DB_HOST=localhost
QUERY_DB_PORT=5434
QUERY_DB_NAME=tapai_query
QUERY_DB_USER=tapai
QUERY_DB_PASSWORD=tapai_password

# ── Query DB - Read-only runtime user ─────────────────
# App bu user ilə QueryDb-ə qoşulur (yalnız SELECT).
# Migrations üçün QUERY_DB_USER (admin) istifadə olunur.
QUERY_READER_PASSWORD=tapai_reader_password

# ── Replication User ──────────────────────────────────
REPLICATOR_PASSWORD=replicator_password

# ── Redis ─────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=tapai_redis_password
REDIS_MAX_MEMORY=256mb

# ── RabbitMQ ──────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=tapai
RABBITMQ_PASSWORD=tapai_rabbit_password
RABBITMQ_VHOST=tapai

# ── MinIO ─────────────────────────────────────────────
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=tapai
MINIO_ROOT_PASSWORD=tapai_minio_password

# ── ASP.NET ───────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000

# ── JWT ───────────────────────────────────────────────
JWT_SECRET=your_super_secret_key_change_this_in_production
JWT_ISSUER=TapAiAPI
JWT_AUDIENCE=TapAiClient
JWT_EXPIRY_MINUTES=60