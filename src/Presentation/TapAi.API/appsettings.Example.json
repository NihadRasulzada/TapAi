{
  "ConnectionStrings": {
    "CommandDb": "Host=localhost;Port=5433;Database=tapai_command;Username=YOUR_USER;Password=YOUR_PASSWORD",
    "QueryDb": "Host=localhost;Port=5434;Database=tapai_query;Username=YOUR_USER;Password=YOUR_PASSWORD",
    "QueryDbApp": "Host=localhost;Port=5434;Database=tapai_query;Username=tapai_reader;Password=YOUR_READER_PASSWORD",
    "Redis": "localhost:6379,password=YOUR_REDIS_PASSWORD,abortConnect=false"
  },
  "Jwt": {
    "SecretKey": "YOUR_SECRET_KEY_MINIMUM_32_CHARACTERS_LONG",
    "Issuer": "TapAiAPI",
    "Audience": "TapAiClient",
    "AccessTokenExpiryMinutes": 60
  },
  "RegistrationJwt": {
    "SecretKey": "YOUR_REGISTRATION_JWT_SECRET_MINIMUM_32_CHARACTERS",
    "ExpirySeconds": 600
  },
  "Otp": {
    "ExpirySeconds": 300,
    "DefaultCode": "0000",
    "MaxAttempts": 3
  },
  "BruteForce": {
    "MaxFailedAttempts": 5,
    "BlockDurationSeconds": 900
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "tapai",
    "Username": "YOUR_RABBITMQ_USER",
    "Password": "YOUR_RABBITMQ_PASSWORD"
  },
  "MinIO": {
    "Endpoint": "localhost:9000",
    "AccessKey": "YOUR_MINIO_ROOT_USER",
    "SecretKey": "YOUR_MINIO_ROOT_PASSWORD",
    "BucketName": "tapai-dev",
    "UseSSL": false
  },
  "ImageResize": {
    "MaxWidth": 1920,
    "MaxHeight": 1080,
    "BatchSize": 10,
    "PollingIntervalSeconds": 30
  },
  "Email": {
    "From": "",
    "SmtpHost": "",
    "SmtpPort": "",
    "Username": "",
    "Password": ""
  }
}